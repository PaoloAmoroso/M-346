          setprop("controls/signal5", 0);
          setprop("controls/signal6", 0);

          setprop("ai/submodels/GBU12E-number", 2);
          setprop("controls/signal14", 0);
          setprop("controls/signal15", 0);

          setprop("ai/submodels/GBU12I-number", 2);
          setprop("controls/signal7", 0);
          setprop("controls/signal8", 0);

          setprop("ai/submodels/Brimstone-number", 6);
          setprop("controls/signal16", 0);
          setprop("controls/signal17", 0);
          setprop("controls/signal18", 0);
          setprop("controls/signal19", 0);
          setprop("controls/signal20", 0);
          setprop("controls/signal21", 0);

          </script>
        </binding>

      <binding>
        <command>property-assign</command>
        <property>controls/Tanks</property>
        <value>0</value>
      </binding>
      <binding>
        <command>property-assign</command>
        <property>controls/TankC</property>
        <value>0</value>
      </binding>
      <binding>
        <command>nasal</command>
        <script>
          if (!getprop("gear/gear[0]/wow")) {
            screen.log.write("This is only possible on ground.");
            return;
          }
          if (getprop("gear/gear[0]/position-norm")) {
            screen.log.write("Weapons Reloaded.");
          }
        </script>
      </binding>
