<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>mfd-pfd.ac</path>

  <animation>
    <!-- Objets opaques -->
    <object-name>fond</object-name>
    <object-name>fondL</object-name>
    <object-name>canvasCadre</object-name>
    <object-name>fondR</object-name>
    <object-name>infoL</object-name>
    <object-name>infoC</object-name>
    <object-name>infoR</object-name>
    <object-name>knobL</object-name>
    <object-name>knobs</object-name>
    <object-name>knobR</object-name>

    <!-- Objets transparents -->
    <object-name>vitre</object-name>
  </animation>

  <!-- working for Compositor -->
  <effect>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>canvasCadre</object-name>
    <object-name>knobL</object-name>
    <object-name>knobs</object-name>
    <object-name>knobR</object-name>
    <object-name>Radar_A</object-name>
    <object-name>Radar_T</object-name>
    <object-name>Radar_G</object-name>

    <emission>
      <factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

  <animation>
    <type>material</type>
    <object-name>GND</object-name>
    <object-name>TWS</object-name>
    <object-name>RNG</object-name>
    <object-name>RNG_1</object-name>
    <emission>
      <factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
      <red>   0.20 </red>
      <green> 0.60 </green>
      <blue>  0.40 </blue>
    </emission>
  </animation>

  <model>
    <path>Aircraft/M-346/Models/Cockpit/Instruments/mfd-pfd/pfd.xml</path>
    <offsets>
      <x-m>  0.005 </x-m>
      <y-m> -0.162 </y-m>
      <z-m> -0.026 </z-m>
    </offsets>
    <overlay>
      <animation n="100">
        <type>scale</type>
        <property>constants/zero</property>
        <x-offset> 0.78 </x-offset>
        <y-offset> 0.78 </y-offset>
        <z-offset> 0.78 </z-offset>
      </animation>
    </overlay>
  </model>

  <model>
    <name>MFDSCREEN</name>
    <path>Aircraft/M-346/Models/Cockpit/Instruments/mfd-pfd/mfd.xml</path>
    <offsets>
      <x-m>  0.003 </x-m>
      <y-m>  0.163 </y-m>
      <z-m> -0.026 </z-m>
    </offsets>
    <overlay>
      <animation n="100">
        <type>scale</type>
        <property>constants/zero</property>
        <x-offset> 0.77 </x-offset>
        <y-offset> 0.77 </y-offset>
        <z-offset> 0.77 </z-offset>
      </animation>
    </overlay>
  </model>

  <model>
    <name>EICASSCREEN</name>
    <path>Aircraft/M-346/Models/Cockpit/Instruments/mfd-pfd/eicas.xml</path>
    <offsets>
      <x-m>  0.003 </x-m>
      <y-m>  0.163 </y-m>
      <z-m> -0.026 </z-m>
    </offsets>
    <overlay>
      <animation n="100">
        <type>scale</type>
        <property>constants/zero</property>
        <x-offset> 0.77 </x-offset>
        <y-offset> 0.77 </y-offset>
        <z-offset> 0.77 </z-offset>
      </animation>
    </overlay>
  </model>

  <animation>
    <type>select</type>
    <object-name>MFDSCREEN</object-name>
    <condition>
      <not><property>instrumentation/pfd/mode</property></not>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>EICASSCREEN</object-name>
    <condition>
      <property>instrumentation/pfd/mode</property>
    </condition>
  </animation>

  <animation>
    <type>pick</type>
    <visible>true</visible>
    <object-name>knobR</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-toggle</command>
        <property>instrumentation/pfd/mode</property>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>knobR</object-name>
    <property>instrumentation/pfd/mode</property>
    <factor> 35 </factor>
    <center>
      <x-m> 0.010 </x-m>
      <y-m> 0.249 </y-m>
      <z-m> 0.070 </z-m>
    </center>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

<!-- Map/Radar Mode -->

  <model>
    <name>Radar_A</name>
    <path>Aircraft/M-346/Models/Cockpit/Instruments/Radar/ND/nd.xml</path>
    <offsets>
      <z-m>  0.00400 </z-m>
    </offsets>
    <overlay>
      <animation n="100">
        <type>scale</type>
        <property>constants/zero</property>
        <x-offset> 1.5 </x-offset>
        <y-offset> 1.5 </y-offset>
        <z-offset> 1.5 </z-offset>
      </animation>
    </overlay>
  </model>

  <model>
    <name>Radar_T</name>
    <path>Aircraft/M-346/Models/Cockpit/Instruments/Radar/TWS/TWS.xml</path>
    <offsets>
      <x-m> -0.046002 </x-m>
      <y-m>  0.020528 </y-m>
      <z-m> -0.017469 </z-m>
    </offsets>
    <overlay>
      <animation n="all">
        <type>scale</type>
        <property>constants/zero</property>
        <x-offset> 1.3 </x-offset>
        <y-offset> 1.3 </y-offset>
        <z-offset> 1.3 </z-offset>
      </animation>
    </overlay>
  </model>

  <model>
    <name>Radar_G</name>
    <path>Aircraft/M-346/Models/Cockpit/Instruments/Radar/SAR/SAR.xml</path>
    <offsets>
      <x-m> -0.046002 </x-m>
      <y-m>  0.020528 </y-m>
      <z-m> -0.017469 </z-m>
    </offsets>
    <overlay>
      <animation n="all">
        <type>scale</type>
        <property>constants/zero</property>
        <x-offset> 1.3 </x-offset>
        <y-offset> 1.3 </y-offset>
        <z-offset> 1.3 </z-offset>
      </animation>
    </overlay>
  </model>

  <animation>
    <type>select</type>
    <object-name>canvasCadre</object-name>
    <condition>
     <equals>
      <property>instrumentation/radar/mode</property>
      <value>0</value>
     </equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>Radar_A</object-name>
    <condition>
     <equals>
      <property>instrumentation/radar/mode</property>
      <value>1</value>
     </equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>Radar_T</object-name>
    <object-name>TWS</object-name>
    <condition>
     <equals>
      <property>instrumentation/radar/mode</property>
      <value>2</value>
     </equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>Radar_G</object-name>
    <object-name>GND</object-name>
    <condition>
     <equals>
      <property>instrumentation/radar/mode</property>
      <value>3</value>
     </equals>
    </condition>
  </animation>

  <animation>
    <type>pick</type>
    <visible>true</visible>
    <object-name>knobs</object-name>
    <action>
      <button>0</button>
      <repeatable>true</repeatable>
      <binding>
        <command>property-adjust</command>
        <property>/instrumentation/radar/mode</property>
        <step> 1 </step>
        <min>  0 </min>
        <max>  4 </max>
        <wrap>true</wrap>
      </binding>
    </action>
  </animation>

<!-- Radar Button for Air Traffic Informations -->

  <animation>
    <type>pick</type>
    <visible>true</visible>
    <object-name>knobL</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-toggle</command>
        <property>instrumentation/radar/info</property>
      </binding>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>bridge</tooltip-id>
        <label>Aircraft Informations</label>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>knobL</object-name>
    <property>instrumentation/radar/info</property>
    <factor> 35 </factor>
    <center>
      <x-m> 0.010 </x-m>
      <y-m> 0.249 </y-m>
      <z-m> 0.070 </z-m>
    </center>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <!-- RADAR MODE TEXT -->

  <text>
    <name>GND</name>
    <font>lucida.txf</font>
    <character-size type="double">0.01</character-size>
    <offsets>
      <x-m>  0.003947 </x-m>
      <y-m> -0.097967 </y-m>
      <z-m>  0.052524 </z-m>
    </offsets>
    <axis-alignment>yz-plane</axis-alignment>
    <type type="string">literal</type>
    <text type="string">GND</text>
    <draw-text type="bool">true</draw-text>
    <alignment>left-center</alignment>
  </text>

  <animation>
    <type>pick</type>
    <visible>true</visible>
    <object-name>GND</object-name>
    <action>
      <button>0</button>
      <repeatable>true</repeatable>
      <binding>
        <command>nasal</command>
        <script><![CDATA[
          var mode = getprop("/instrumentation/radar/display-mode");

          if (mode == "ARC") {
            setprop("/instrumentation/radar/display-mode", "NOARC");
          } else {
            setprop("/instrumentation/radar/display-mode", "ARC");
          }
        ]]></script>
      </binding>
    </action>
  </animation>

  <text>
    <name>TWS</name>
    <font>lucida.txf</font>
    <character-size type="double">0.01</character-size>
    <offsets>
      <x-m>  0.003947 </x-m>
      <y-m> -0.097967 </y-m>
      <z-m>  0.052524 </z-m>
    </offsets>
    <axis-alignment>yz-plane</axis-alignment>
    <type type="string">literal</type>
    <text type="string">TWS</text>
    <draw-text type="bool">true</draw-text>
    <alignment>left-center</alignment>
  </text>

  <animation>
    <type>pick</type>
    <object-name>TWS</object-name>
    <visible>true</visible>
    <action>
      <button>0</button>
      <repeatable>true</repeatable>
      <binding>
        <command>property-adjust</command>
        <property>/instrumentation/radar/air-to-air</property>
        <step> 1 </step>
        <min>  0 </min>
        <max>  4 </max>
        <wrap>true</wrap>
      </binding>
    </action>
  </animation>

  <text>
    <name>RNG</name>
    <font>lucida.txf</font>
    <character-size type="double">0.01</character-size>
    <offsets>
      <x-m>  0.003947 </x-m>
      <y-m> -0.097967 </y-m>
      <z-m>  0.028560 </z-m>
    </offsets>
    <axis-alignment>yz-plane</axis-alignment>
    <type type="string">literal</type>
    <text type="string">RNG</text>
    <draw-text type="bool">true</draw-text>
    <alignment>left-center</alignment>
  </text>

  <animation>
    <type>pick</type>
    <object-name>RNG</object-name>
    <visible>true</visible>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-cycle</command>
        <property>instrumentation/radar[0]/range</property>
        <value type="float">5</value>
        <value type="float">10</value>
        <value type="float">20</value>
        <value type="float">40</value>
        <value type="float">80</value>
        <!-- <value type="float">160</value>
        <value type="float">320</value>
        <value type="float">640</value> -->
        <wrap>true</wrap>
      </binding>
    </action>
  </animation>

  <text>
    <name>RNG_1</name>
    <font>lucida.txf</font>
    <character-size type="double">0.01</character-size>
    <offsets>
      <x-m>  0.003947 </x-m>
      <y-m> -0.097967 </y-m>
      <z-m>  0.015816 </z-m>
    </offsets>
    <axis-alignment>yz-plane</axis-alignment>
    <type>string</type>
    <format type="string">%s NM</format>
    <property>instrumentation/radar[0]/range</property>
    <draw-text type="bool">true</draw-text>
    <alignment>left-center</alignment>
  </text>

<animation>
  <type>select</type>
  <object-name>RNG</object-name>
  <object-name>RNG_1</object-name>
  <condition>
    <not>
      <or>
        <equals>
          <property>instrumentation/radar/mode</property>
          <value>0</value>
        </equals>
        <equals>
          <property>instrumentation/radar/mode</property>
          <value>1</value>
        </equals>
      </or>
    </not>
  </condition>
</animation>

</PropertyList>
