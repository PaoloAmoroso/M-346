        <property>controls/armament/trigger</property>
        <value type="bool">true</value>
      </binding>
      <mod-up>
        <binding>
        <condition>
          <and>
            <property>sim/model/show-Cannon</property>
              <value>1</value>
          </and>
        </condition>
          <command>property-assign</command>
          <property>controls/armament/trigger</property>
          <value type="bool">false</value>
        </binding>
      </mod-up>
    </key>


<key n="69">
  <name>Shift+e</name>
  <desc>Release Missile</desc>
  <binding>
    <command>nasal</command>
    <script><![CDATA[

      # AIM-9M Wingtip
            if ((getprop("/sim/model/show-AIM9M-W")) and !getprop("/sim/launching-AIM9W")) {
        var AIM9WCount = getprop("ai/submodels/AIM9W-number");
        if (AIM9WCount > 0 and AIM9WCount <= 2) {
          setprop("/sim/launching-AIM9W", 1);

          var triggerPath = "/controls/signal" ~ (3 - AIM9WCount); #(3 - 2) = 1 allora "signal1" e (3 - 1) = 2 allora "signal2"
          setprop(triggerPath, 1);

          settimer(func() { setprop(triggerPath, 0); }, 0.2);
          settimer(func() {
            setprop("ai/submodels/AIM9W-number", AIM9WCount - 1);
            setprop("/sim/launching-AIM9W", 0);
          }, 0.3);
        }
      }

    ]]></script>
  </binding>
</key>

    <key n="110">
      <name>n</name>
  <binding>
    <command>nasal</command>
    <script><![CDATA[

      # AIM-9M External Pylons
            if ((getprop("/sim/model/show-AIM9M-E")) and !getprop("/sim/launching-AIM9E")) {
        var AIM9ECount = getprop("ai/submodels/AIM9E-number");
        if (AIM9ECount > 0 and AIM9ECount <= 2) {
          setprop("/sim/launching-AIM9E", 1);

          var triggerPath = "/controls/signal" ~ (12 - AIM9ECount); #(12 - 2) = 10 allora "signal10" e (12 - 1) = 11 allora "signal11"
          setprop(triggerPath, 1);

          settimer(func() { setprop(triggerPath, 0); }, 0.2);
          settimer(func() {
            setprop("ai/submodels/AIM9E-number", AIM9ECount - 1);
            setprop("/sim/launching-AIM9E", 0);
          }, 0.3);
        }
      }

      # MK-82 External Pylons
            if ((getprop("/sim/model/show-MK82-E")) and !getprop("/sim/launching-MK82E")) {
        var MK82ECount = getprop("ai/submodels/MK82E-number");
        if (MK82ECount > 0 and MK82ECount <= 2) {
          setprop("/sim/launching-MK82E", 1);

          var triggerPath = "/controls/signal" ~ (5 - MK82ECount); #(5 - 2) = 3 allora "signal3" e (5 - 1) = 4 allora "signal4"
          setprop(triggerPath, 1);

          settimer(func() { setprop(triggerPath, 0); }, 0.2);
          settimer(func() {
            setprop("ai/submodels/MK82E-number", MK82ECount - 1);
            setprop("/sim/launching-MK82E", 0);
          }, 0.3);
        }
      }

      # GBU-12 External Pylons
            if ((getprop("/sim/model/show-GBU12-E")) and !getprop("/sim/launching-GBU12E")) {
        var GBU12ECount = getprop("ai/submodels/GBU12E-number");
        if (GBU12ECount > 0 and GBU12ECount <= 2) {
          setprop("/sim/launching-GBU12E", 1);

